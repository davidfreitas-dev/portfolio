{
    "name": "davidfreitas/portfolio-api",
    "description": "API do Portfolio com Slim Framework",
    "type": "project",
    "require": {
        "php": "^8.4",
        "beberlei/assert": "^3.3",
        "firebase/php-jwt": "^7.0",
        "monolog/monolog": "^3.5",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "selective/basepath": "^2.2",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.13",
        "symfony/expression-language": "^8.0",
        "symfony/validator": "^7.0",
        "tuupola/cors-middleware": "^1.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.52",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.7",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "audit": {
        "ignore": [
            "PKSA-y2cr-5h3j-g3ys",
            "PKSA-2kqm-ps5x-s4f5"
        ]
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "cs-check": "php-cs-fixer fix --config=tools/.php-cs-fixer.dist.php --dry-run --diff --verbose",
        "cs-fix": "php-cs-fixer fix --config=tools/.php-cs-fixer.dist.php --verbose",
        "rector": "rector process --config tools/rector.php",
        "rector:dry": "rector process --config tools/rector.php --dry-run",
        "test": "pest",
        "test:unit": "pest tests/Unit"
    }
}
